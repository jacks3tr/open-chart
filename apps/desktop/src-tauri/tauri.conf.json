{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChart",
  "version": "0.0.0",
  "identifier": "com.openchart.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../.. run dev --workspace @openchart/app -- --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix ../.. run build --workspace @openchart/app",
    "frontendDist": "../../../packages/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenChart",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "theme": "Light",
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
